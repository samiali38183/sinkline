                "text": "Raw SQL text built from tainted data. OWASP A03:2021 Injection; CWE-89 SQL Injection."
              },
              "help": {
                "text": "Bind parameters: text('... WHERE id = :id').bindparams(id=user_id)",
                "markdown": "**Fix:** Bind parameters: text('... WHERE id = :id').bindparams(id=user_id)"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
