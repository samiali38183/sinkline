{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/master/Schemata/sarif-schema-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "sinkline",
          "version": "0.3.0",
          "informationUri": "https://github.com/samiali38183/sinkline",
          "semanticVersion": "0.3.0",
          "rules": [
            {
              "id": "SL-SQLI-001",
              "name": "SQLbuiltfromtainteddata",
              "shortDescription": {
                "text": "SQL built from tainted data"
              },
              "fullDescription": {
                "text": "SQL built from tainted data. OWASP A03:2021 Injection; CWE-89 SQL Injection."
              },
              "help": {
                "text": "Use parameterized queries: cursor.execute('... WHERE id = ?', (user_id,))",
                "markdown": "**Fix:** Use parameterized queries: cursor.execute('... WHERE id = ?', (user_id,))"
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/owasp/A03-2021",
                  "external/cwe/cwe-89"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
              "id": "SL-SQLI-002",
              "name": "SQLscriptbuiltfromtainteddata",
              "shortDescription": {
                "text": "SQL script built from tainted data"
              },
              "fullDescription": {
                "text": "SQL script built from tainted data. OWASP A03:2021 Injection; CWE-89 SQL Injection."
              },
              "help": {
                "text": "executescript cannot be parameterized; never pass user input to it.",
                "markdown": "**Fix:** executescript cannot be parameterized; never pass user input to it."
              },
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "tags": [
                  "security",
                  "external/owasp/A03-2021",
                  "external/cwe/cwe-89"
                ],
                "security-severity": "9.5",
                "precision": "high"
              }
            },
            {
